# VPN Configuration

# Server Connection (required for client)
SERVER_IP=your.server.ip.here
SERVER_PORT=8888

# Network Configuration
CLIENT_TUN_IP=10.8.0.2
SERVER_TUN_IP=10.8.0.1
VPN_SUBNET=10.8.0.0/24

# Encryption (REQUIRED)
# Pre-shared key - MUST be 32 bytes (64 hex characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=changeme_generate_a_real_key_with_command_above
